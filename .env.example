# Copy to .env (never commit .env). Generate secrets with:  python -m gateway.manage gen-key
# ------------------------------------------------------------------ platform v2 (python -m gateway.server)
# development | production (production: secure cookies, HSTS, no demo logins, waitress).
# Keep comments on their own lines: systemd EnvironmentFile does not strip inline comments.
RPM_ENV=development
# RPM_MASTER_KEY=                   # REQUIRED in production. 32 random bytes, urlsafe base64. Wraps device keys + TOTP secrets.
#                                     In development it is generated once into data/.master_key (git-ignored).
# RPM_GATEWAY_INGEST_TOKEN=         # shared secret between the Pi hardware gateway service and the platform.
#                                     Unset = hardware ingestion endpoint disabled (simulation still works).
# RPM_HOST=127.0.0.1
# RPM_PORT=8000
# RPM_DATA_DIR=data
# RPM_MODEL_DIR=ml/models
# RPM_GATEWAY_ID=1                  # destinationId of the doctor gateway (FLoRa doctorId)
# RPM_MAX_HOP_COUNT=4
# RPM_DEVICE_OFFLINE_AFTER_S=180    # hardware devices: no valid frame for this long -> offline
# RPM_STALE_AFTER_S=120
# RPM_ESCALATE_AFTER_S=180
# RPM_SESSION_IDLE_S=1800
# RPM_SESSION_ABSOLUTE_S=43200
# RPM_RETENTION_DAYS=30
# RPM_PREDICTIVE_ALERTS=1
# RPM_ALLOW_LEGACY_V1=0             # accept unauthenticated 16-byte v1 packets from the gateway (migration only)
# Optional e-mail notifications (hardware mode, critical/high alerts). Not delivery-tested by the project.
# RPM_SMTP_HOST=
# RPM_SMTP_PORT=587
# RPM_SMTP_USER=
# RPM_SMTP_PASSWORD=
# RPM_SMTP_FROM=
# ------------------------------------------------------------------ legacy pre-MVP API (python -m gateway.app) - unchanged
DOCTOR_TOKEN=change-me
ADMIN_TOKEN=change-me-too
# DB_PATH=data/rpm.sqlite3
# VITALS_MIN_INTERVAL_S=30
